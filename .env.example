# Required
RPC_URL=https://your-rpc-url-here

# Optional - Server
PORT=8000

# Optional - Chain config
CHAIN_ID=80094
CHAIN_NAME=BeraChain
NATIVE_NAME=BERA
NATIVE_SYMBOL=BERA
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
POLLING_INTERVAL=200

# Optional - Factory config
FACTORY_ADDRESS=0x182a927119d56008d921126764bf884221b10f59
FACTORY_FEE=0.003
FACTORY_INIT_CODE_HASH=0x
FACTORY_PROVIDER=UniswapV2
FACTORY_BUY_GAS=60000
FACTORY_SELL_GAS=60000

# Optional - Extractor settings
CACHE_DIR=./cache
LOG_DEPTH=50
ENABLE_LIQUIDITY_FILTER=true

# Optional - Base tokens for prefetching (JSON array)
# TOKENS='[{"address":"0x...","decimals":18,"symbol":"WMON","name":"Wrapped MON"}]'
