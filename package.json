{
  "name": "viem-go-extractor-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "start:ts": "bun run mini-extractor-ts/index.ts",
    "dev:ts": "bun --watch mini-extractor-ts/index.ts",
    "start:go": "cd mini-extractor-go && go run .",
    "dev": "make dev",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@biomejs/biome": "^2.3.14",
    "abitype": "1.0.8",
    "elysia": "1.2.25",
    "pino": "9.6.0",
    "viem": "2.23.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.8"
  }
}
